    def on_title_case(self, *_):
        return self.apply_text_transform(title_case, "Title Case")

    def on_sentence_case(self, *_):
        return self.apply_text_transform(sentence_case, "Sentence Case")

    def on_sort_lines_ascending(self, *_):
        return self.apply_text_transform(lambda t: sort_lines(t, reverse=False), "Sort A-Z")

    def on_sort_lines_descending(self, *_):
        return self.apply_text_transform(lambda t: sort_lines(t, reverse=True), "Sort Z-A")

    def _clipboard(self):
        return Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)

    def on_cut(self, *_):
        self.editor_transaction.cut_clipboard(self._clipboard(), True)

    def on_copy(self, *_):
        self.text.get_buffer().copy_clipboard(self._clipboard())

    def on_paste(self, *_):
        self.editor_transaction.paste_clipboard(self._clipboard(), True)

    def on_select_all(self, *_):
        buf = self.text.get_buffer()
        start, end = buf.get_bounds()
        buf.select_range(start, end)

    def on_paste_clean_pdf(self, *_):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        text = clipboard.wait_for_text()
        if text is None:
            return
        cleaned = clean_pdf_text(text)
        b = self.text.get_buffer()
        cursor = b.get_iter_at_mark(b.get_insert()).get_offset()
        selection = None
        if b.get_has_selection():
            s, e = b.get_selection_bounds()
            selection = (s.get_offset(), e.get_offset())
        start, end, insertion, select_range = command_paste_text_plan(
            self.buffer_text(),
            cleaned,
            cursor,
            selection=selection,
        )
        def edit(buf):
            it1 = buf.get_iter_at_offset(start)
            it2 = buf.get_iter_at_offset(end)
            buf.delete(it1, it2)
            buf.insert(buf.get_iter_at_offset(start), insertion)
        self.execute_command("Paste Clean PDF", edit, select_range=select_range)

    def on_paste_plain_text(self, *_):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        text = clipboard.wait_for_text()
        if text is None:
            return
        b = self.text.get_buffer()
        cursor = b.get_iter_at_mark(b.get_insert()).get_offset()
        selection = None
        if b.get_has_selection():
            s, e = b.get_selection_bounds()
            selection = (s.get_offset(), e.get_offset())
        start, end, insertion, _inserted_range = command_paste_text_plan(
            self.buffer_text(),
            text,
            cursor,
            selection=selection,
        )
        caret = start + len(insertion)
        def edit(buf):
            it1 = buf.get_iter_at_offset(start)
            it2 = buf.get_iter_at_offset(end)
            buf.delete(it1, it2)
            buf.insert(buf.get_iter_at_offset(start), insertion)
        return self.execute_command(
            "Paste Plain Text",
            edit,
            select_range=(caret, caret),
        )

    def on_duplicate_line_or_selection(self, *_):
        b = self.text.get_buffer()
        selection = None
        if b.get_has_selection():
            s, e = b.get_selection_bounds()
            selection = (s.get_offset(), e.get_offset())
        plan = command_duplicate_line_or_selection_plan(
            self.buffer_text(),
            self.get_cursor_offset(),
            selection=selection,
        )
        if plan is None:
            return
        insert_pos, insertion, select_range, duplicates_selection = plan
        def edit(buf):
            buf.insert(buf.get_iter_at_offset(insert_pos), insertion)
        action_name = "Duplicate Selection" if duplicates_selection else "Duplicate Line"
        return self.execute_command(action_name, edit, select_range=select_range)

    def on_move_line(self, direction):
        text = self.buffer_text()
        if not text:
            return
        cursor = self.get_cursor_offset()
        lines = text.splitlines(True)
        if not lines:
            return
        offsets = []
        pos = 0
        for line in lines:
            offsets.append(pos)
            pos += len(line)
        idx = 0
        for i, start in enumerate(offsets):
            end = start + len(lines[i])
            if start <= cursor < end or (i == len(lines) - 1 and cursor == end):
                idx = i
                break
        new_idx = idx + int(direction)
        if new_idx < 0 or new_idx >= len(lines):
            return
        col = max(0, cursor - offsets[idx])
        moved_line_len = len(lines[idx])
        lines[idx], lines[new_idx] = lines[new_idx], lines[idx]
        new_text = "".join(lines)
        new_offsets = []
        pos = 0
        for line in lines:
            new_offsets.append(pos)
            pos += len(line)
        new_cursor = min(new_offsets[new_idx] + col, new_offsets[new_idx] + moved_line_len)
        def edit(buf):
            buf.set_text(new_text)
        self.execute_command("Move Line", edit, select_range=(new_cursor, new_cursor))

    def on_trim_trailing_on_save(self, item):
        return self.update_preferences(trim_trailing_on_save=bool(item.get_active()))

    def on_document_statistics(self, *_):
        text_before_statistics = self.buffer_text()
        result = self.command_layer.dispatch(
            "writing.statistics",
            CommandContext(source="gui", data={"text": text_before_statistics}),
        )
        if result.success and isinstance(result.value, dict) and "statistics" in result.value:
            stats = result.value["statistics"]
        else:
            stats = document_statistics(text_before_statistics)
        msg = (
            f"Words: {stats['words']}\n"
            f"Characters: {stats['characters']}\n"
            f"Characters without spaces: {stats['characters_no_spaces']}\n"
            f"Paragraphs: {stats['paragraphs']}\n"
            f"Lines: {stats['lines']}\n"
            f"Estimated reading time: {stats['reading_minutes']} min"
        )
        self.large_info("Document Statistics", msg)

    def populate_template_menu(self):
        templates = tuple(list_templates(self.config_dir))
        adapter = getattr(self, "menu_ui_adapter", None)
        if adapter is not None:
            adapter.render_dynamic("templates", template_rows(templates))
        return templates

    def on_new_from_template(self, path):
        if not self.may_continue():
            return False
        try:
            plan = prepare_new_from_template_plan(path, read_template(path))
            return self.execute_new_from_template_plan(plan)
        except (OSError, UnicodeError, TypeError, ValueError) as e:
            self.error(str(e))
            return False

    def execute_new_from_template_plan(self, plan):
        # Template plans share the authoritative new-document transition shape.
        self.document_session_controller.execute_new(
            NewPlan(
                text=plan.text,
                target_path=plan.target_path,
                modified=plan.modified,
            )
        )
        self._research_components.runtime.research_document_context_changed()
        self.update_title()
        self.document_overview_runtime.refresh_if_open()
        return True

    def on_save_as_template(self, *_):
        """Copy the active buffer into the template store without saving the document."""
        try:
            templates_dir = ensure_templates_dir(self.config_dir)
            selected_path = choose_save_template(
                self,
                templates_dir,
                suggest_template_filename(self.current_file),
            )
            if selected_path is None:
                return False
            plan = prepare_save_template_plan(
                self.config_dir,
                selected_path,
                self.buffer_text(),
            )
            if plan is None:
                return False
            write_template_atomic(plan)
        except (OSError, UnicodeError, TypeError, ValueError) as e:
            self.error(str(e))
            return False

        self.populate_template_menu()
        self.info(f"Template saved: {os.path.basename(plan.target_path)}")
        return True

    def on_manage_templates(self, *_):
        """Open the bounded rename/delete manager for canonical templates."""
        try:
            entries = list_managed_templates(self.config_dir)
        except (OSError, TypeError, ValueError) as e:
            self.error(str(e))
            return False
        return run_manage_templates_dialog(
            self,
            entries,
            self.rename_managed_template,
            self.delete_managed_template,
        )

    def rename_managed_template(self, source_path, new_name):
        """Rename one user template, then refresh the derived template menu."""
        try:
            plan = prepare_rename_template_plan(
                self.config_dir,
                source_path,
                new_name,
            )
            if plan is None:
                return None
            rename_template_file(plan)
        except (OSError, TypeError, ValueError) as e:
            self.error(str(e))
            return None

        self.populate_template_menu()
        self.info(f"Template renamed: {plan.target_name}")
        return list_managed_templates(self.config_dir)

    def delete_managed_template(self, target_path):
        """Delete one user template, then refresh the derived template menu."""
        try:
            plan = prepare_delete_template_plan(self.config_dir, target_path)
            delete_template_file(plan)
        except (OSError, TypeError, ValueError) as e:
            self.error(str(e))
            return None

        self.populate_template_menu()
        self.info(f"Template deleted: {plan.target_name}")
        return list_managed_templates(self.config_dir)

    def set_word_wrap(self, requested_enabled):
        try:
            plan = prepare_text_wrap_plan(self.word_wrap, bool(requested_enabled))
        except (TypeError, ValueError) as e:
            self.refresh_ui_state()
            self.error(str(e))
            return False
        if not plan.changed:
            self.refresh_ui_state()
            return False
        return self.update_preferences(word_wrap=plan.enabled)

    def on_word_wrap(self, item):
        return self.set_word_wrap(bool(item.get_active()))

    def toggle_word_wrap(self, *_):
        return self.set_word_wrap(not self.word_wrap)

    def on_transparent_mode(self, item):
        enabled = bool(item.get_active())
        requested = self.opacity_percent if enabled and self.opacity_percent < MAX_OPACITY_PERCENT else (88 if enabled else MAX_OPACITY_PERCENT)
        return self.update_preferences(opacity_percent=requested)

    def toggle_transparent_mode(self, *_):
        enabled = not (self.opacity_percent < MAX_OPACITY_PERCENT)
        requested = 88 if enabled else MAX_OPACITY_PERCENT
        return self.update_preferences(opacity_percent=requested)

    def toggle_always_on_top(self, *_):
        class _RequestedActive:
            def __init__(self, value):
                self._value = bool(value)
            def get_active(self):
                return self._value
        return self.on_top(_RequestedActive(not self.always_on_top))

    def toggle_line_numbers(self, *_):
        return self.update_preferences(line_numbers=not self.line_numbers_enabled)

    def on_font(self, *_):
        dialog = Gtk.FontChooserDialog(title="Font", transient_for=self)
        dialog.set_font(f"{self.font_family} {self.font_size}")
        try:
            if dialog.run() != Gtk.ResponseType.OK:
                return False
            description = Pango.FontDescription(dialog.get_font())
            requested_family = description.get_family()
            requested_size = (
                description.get_size() // Pango.SCALE
                if description.get_size() > 0
                else self.font_size
            )
            try:
                plan = prepare_font_preference_plan(
                    self.font_family,
                    self.font_size,
                    requested_family,
                    int(requested_size),
                )
            except (TypeError, ValueError) as exc:
                self.error(str(exc))
                return False
            if not plan.changed:
                return False
            return self.update_preferences(
                font_family=plan.requested.family,
                font_size=plan.requested.size,
            )
        finally:
            dialog.destroy()

    def command_layer_insert_date_time_text(self, now, fmt="%Y-%m-%d %H:%M"):
        result = self.command_layer.dispatch("writing.insert-date-time", CommandContext(source="gui", data={"now": now, "format": fmt}))
        insertion = result.value.get("text", "") if result.success and isinstance(result.value, dict) else ""
        return (insertion, bool(insertion)) if isinstance(insertion, str) else ("", False)


    def on_replace_all_dialog(self, *_):
        return self._w107_subsystems.search.on_find_replace(*_)

    def load_favourite_store(self):
        return self.favourite_store.canonical()

    def load_favourites(self):
        return self.favourite_store.visible()

    def save_favourites(self, items):
        return self.favourite_store.save(items)

    def populate_favourites_menu(self):
        items = tuple(self.load_favourites())
        adapter = getattr(self, "menu_ui_adapter", None)
        if adapter is not None:
            adapter.render_dynamic("favourites", favourite_rows(items))
        return items

    def open_favourite_path(self, path):
        if not self.may_continue():
            return False
        plan = prepare_open_favorite_plan(
            path,
            path_is_file=os.path.isfile(path),
        )
        if not plan.should_open:
            self.error("Favourite file not found or is not a regular file:\n" + path)
            return False
        return self.open_path(plan.target_path)

    def on_add_favourite(self, *_):
        if not self.current_file:
            self.error("Save the current document before adding it to Favourites.")
            return False
        plan = prepare_add_favorite_plan(
            os.path.abspath(self.current_file),
            self.load_favourite_store(),
        )
        if not self.save_favourites(list(plan.updated_paths)):
            self.error("Could not add file to Favourites.")
            return False
        self.populate_favourites_menu()
        self.info("Added to Favourites:\n" + plan.favorite_path)
        return True

    def apply_favourite_edits(self, text):
        submitted = parse_favorite_edit_text(text)
        resolved = []
        for item in submitted:
            path = os.path.abspath(os.path.expanduser(item))
            resolved.append((path, os.path.isfile(path)))
        plan = prepare_edit_favorite_plan(
            self.load_favourite_store(),
            resolved,
        )
        if not self.save_favourites(list(plan.updated_paths)):
            self.error("Could not save Favourites.")
            return False
        self.populate_favourites_menu()
        if plan.rejected_paths:
            self.error(
                "These favourite entries are not regular files and were skipped:\n"
                + "\n".join(plan.rejected_paths[:10])
            )
        return True

    def on_edit_favourites(self, *_):
        d = Gtk.Dialog(title="Edit Favourites", transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(8)
        box.set_margin_start(10)
        box.set_margin_end(10)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        label = Gtk.Label(label="One file path per line:")
        label.set_xalign(0)
        view = Gtk.TextView()
        view.set_wrap_mode(Gtk.WrapMode.NONE)
        view.get_buffer().set_text("\n".join(self.load_favourite_store()))
        scroll = Gtk.ScrolledWindow()
        scroll.set_size_request(520, 260)
        scroll.add(view)
        box.pack_start(label, False, False, 0)
        box.pack_start(scroll, True, True, 0)
        d.show_all()
        result = False
        if d.run() == Gtk.ResponseType.OK:
            b = view.get_buffer()
            s, e = b.get_bounds()
            result = self.apply_favourite_edits(b.get_text(s, e, True))
        d.destroy()
        return result

    def on_reload_favourites(self, *_):
        self.populate_favourites_menu()
        return True

    def text_stats(self):
        text = self.buffer_text()
        stats = document_statistics(text)
        _old_words, chars, lines = calc_text_stats(text)
        return stats["words"], chars, lines

    def schedule_status_update(self):
        if self.word_count_source:
            return
        def run():
            self.word_count_source = None
            self.update_title()
            return False
        self.word_count_source = GLib.timeout_add(250, run)

    def update_line_numbers(self, *, force=False):
        return refresh_line_number_gutter(self, force=force)

    def load_recent_files(self):
        return self.recent_file_store.visible()

    def save_recent_files(self, items):
        return self.recent_file_store.save(items)

    def add_recent_file(self, path):
        if not path:
            return
        self.recent_file_store.add(path)
        self.populate_recent_menu()

    def populate_recent_menu(self):
        items = tuple(self.load_recent_files())
        adapter = getattr(self, "menu_ui_adapter", None)
        if adapter is not None:
            adapter.render_dynamic("recent-files", recent_file_rows(items))
        return items

    def open_recent_path(self, path):
        if not self.may_continue():
            return False
        plan = prepare_open_recent_plan(
            path,
            self.load_recent_files(),
            path_exists=os.path.exists(path),
        )
        if plan.should_open and self.open_path(path):
            return True
        if not plan.should_open:
            self.error("Recent file not found:\n" + path)
        self.save_recent_files(list(plan.remaining_paths_after_failure))
        self.populate_recent_menu()
        return False

    def on_clear_recent(self, *_):
        plan = prepare_clear_recent_plan(self.load_recent_files())
        if not plan.should_clear:
            return False
        if not self.save_recent_files(list(plan.remaining_paths)):
            self.error("Could not clear recent files.")
            return False
        self.populate_recent_menu()
        return True

    def clear_search_highlights(self):
        if hasattr(self, "search_controller"):
            self.search_controller.clear_highlights()

    def schedule_search_highlight(self):
        if hasattr(self, "search_controller"):
            return self.search_controller.schedule_highlight(GLib.timeout_add)
        return False

    def build_research_panel(self):
        self._research_components = build_research_subsystem(
            ResearchCompositionInput(
                dialog_parent=self,
                right_panel_host=self.right_panel_host,
                text_view=self.text,
                document_session=self.document_session,
                navigation_controller=self.navigation_controller,
                clip_collection=self.clip_collection,
                clip_collection_runtime=self.clip_collection_runtime,
                document_text=self.buffer_text,
                execute_command=self.execute_command,
                set_cursor_offset=self.set_cursor_offset,
                refresh_ui_state=self.refresh_ui_state,
                schedule=lambda delay, callback: GLib.timeout_add(delay, callback),
                cancel=lambda source_id: GLib.source_remove(source_id),
            )
        )
        c = self._research_components
        self.reference_store = c.reference_store
        self.reference_set_store = c.reference_set_store
        self.reference_panel_runtime = c.reference_panel_runtime
        self.reference_set_runtime = c.reference_set_runtime
        self.citation_controller = c.citation_controller
        self.source_note_panel_runtime = c.source_note_panel_runtime
        self.authoring_bridge_runtime = c.authoring_bridge_runtime
        self.scratchpad_runtime = c.scratchpad_runtime
        self.tag_integrity_controller = c.tag_integrity_controller
        self.tags_runtime = c.tags_runtime
        self.tag_integrity_runtime = c.tag_integrity_runtime
        self.research_panel_view = c.panel_view
        self.research_coordinator = c.coordinator
        self.research_panel_runtime = c.panel_runtime
        self.research_integrity_controller = c.research_integrity_controller
        self.research_integrity_runtime = c.research_integrity_runtime
        self.research_export_controller = c.research_export_controller
        self.research_export_runtime = c.research_export_runtime
        self.bibtex_controller = c.bibtex_controller
        self.bibtex_runtime = c.bibtex_runtime
        self.pandoc_export_controller = c.pandoc_export_controller
        self.pandoc_export_runtime = c.pandoc_export_runtime
        return c


    # Compatibility callbacks retained for tests and older menu wiring.
    def on_typewriter_state_changed(self, enabled):
        return typewriter_app.project_typewriter_state(
            enabled,
            set_enabled=lambda value: setattr(self, "typewriter_mode", value),
            refresh_ui_state=self.refresh_ui_state,
            update_title=self.update_title,
        )

    def toggle_focus_mode(self, *_):
        self.focus_mode = not self.focus_mode
        self.text.set_left_margin(42 if self.focus_mode else 10)
        self.text.set_right_margin(42 if self.focus_mode else 10)
        self.update_title()

    def toggle_distraction_free(self, *_):
        self.distraction_free = not self.distraction_free
        if self.distraction_free:
            self.fullscreen()
            self.menubar.hide()
            self.status.hide()
        else:
            self.unfullscreen()
            self.menubar.show()
            self.status.show()

    def toggle_current_line_highlight(self, *_):
        self.current_line_highlight = not self.current_line_highlight
        self.update_current_line_highlight()

    def update_current_line_highlight(self):
        if not hasattr(self, "current_line_tag"):
            return
        b = self.text.get_buffer()
        s, e = b.get_bounds()
        b.remove_tag(self.current_line_tag, s, e)
        if not self.current_line_highlight:
            return
        cur = b.get_iter_at_mark(b.get_insert())
        start = cur.copy()
        start.set_line_offset(0)
        # Tag through the logical line terminator when one exists. Together
        # with paragraph-background this projects a row, rather than painting
        # only behind the glyphs before the caret line's final character.
        end = start.copy()
        if not end.forward_line():
            end = b.get_end_iter()
        if not start.equal(end):
            b.apply_tag(self.current_line_tag, start, end)

    def toggle_bookmark(self, *_):
        off = self.get_cursor_offset()
        if off in self.bookmarks:
            self.bookmarks.remove(off)
            self.status.set_text("Bookmark removed")
        else:
            self.bookmarks.append(off)
            self.bookmarks.sort()
            self.status.set_text("Bookmark added")

    def next_bookmark(self, *_):
        if not self.bookmarks:
            return
        cur = self.get_cursor_offset()
        target = next((x for x in self.bookmarks if x > cur), self.bookmarks[0])
        self.set_cursor_offset(target)

    def previous_bookmark(self, *_):
        if not self.bookmarks:
            return
        cur = self.get_cursor_offset()
        prior = [x for x in self.bookmarks if x < cur]
        target = prior[-1] if prior else self.bookmarks[-1]
        self.set_cursor_offset(target)

    def on_manage_bookmarks(self, *_):
        if not self.bookmarks:
            self.info("No bookmarks have been inserted. Use Revise > Insert Bookmark Here or Ctrl+F2.")
            return
        lines = []
        text = self.buffer_text()
        for i, off in enumerate(self.bookmarks, start=1):
            line = text.count("\n", 0, max(0, min(off, len(text)))) + 1
            lines.append(f"{i}. Line {line} — offset {off}")
        self.large_info("Bookmarks", "\n".join(lines))

    def on_navigator_item_toggled(self, item):
        return self.navigator_panel_runtime.set_visible(bool(item.get_active()))

    def on_navigator_visibility_changed(self, _visible):
        self.refresh_ui_state()

    def toggle_navigator_panel(self, *_):
        return self.navigator_panel_runtime.toggle()

    def hide_navigator_panel(self, *_):
        return self.navigator_panel_runtime.hide()

    def on_go_to_line(self, *_):
        return run_go_to_line_dialog(self, self.navigation_controller)

    def on_go_to_section(self, *_):
        return run_go_to_section_dialog(self, self.navigation_controller)

    def on_next_heading(self, *_):
        heading = self.navigation_controller.next_heading()
        self.status.set_text(
            f"Heading: {heading.display_title}" if heading else "No next heading."
        )
        return heading is not None

    def on_previous_heading(self, *_):
        heading = self.navigation_controller.previous_heading()
        self.status.set_text(
            f"Heading: {heading.display_title}" if heading else "No previous heading."
        )
        return heading is not None

    def select_range(self, start, end):
        return self._w107_subsystems.spellcheck.select_range(start, end)

    def shortcut_rows(self):
        return SHORTCUT_ROWS

    def on_user_guide(self, *_):
        show_user_guide(self, load_user_guide())

    def on_keyboard_shortcuts(self, *_):
        show_keyboard_shortcuts(self, self.shortcut_rows())

    def on_about(self, *_):
        present_about_dialog(self, self.runtime_identity())

    def info(self, msg):
        show_info(self, msg)

    def large_info(self, title, body):
        show_large_info(self, title, body)

    def error(self, msg):
        show_error(self, msg)

def _refresh_line_numbers_after_map(win, _event):
    # The first mapped allocation is the earliest reliable point for applying
    # the viewport-aligned drawing gutter on the real GTK desktop.
    win.update_line_numbers(force=True)
    return False

if __name__ == "__main__":
    win = App()
    win.connect("map-event", _refresh_line_numbers_after_map)
    win.show_all()
    # Keep the synchronous refresh for persisted disabled state; the mapped
    # forced refresh above repairs the first visible allocation when enabled.
    win.update_line_numbers()
    # The canonical right-panel host starts detached.
    Gtk.main()
