MIN_WINDOW_HEIGHT = 360
MAX_WINDOW_WIDTH = 1600
MAX_WINDOW_HEIGHT = 1000

class App(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_TITLE)
        self.persistence = build_preferences_application_state_components(CONFIG_DIR)
        self.preferences = self.persistence.preferences
        self.application_state = self.persistence.application_state
        self.recent_file_store = self.persistence.recent_files
        self.favourite_store = self.persistence.favourites
        self.recent_workspace_store = self.persistence.recent_workspaces
        self.command_layer = build_pure_command_layer()
        self.command_actions = None
        self.ui_state_components = None
        self.ui_state_controller = None
        self.application_lifecycle = ApplicationLifecycleCoordinator()

        persisted_state = self.application_state.current
        width = persisted_state.width
        height = persisted_state.height
        # Inline spell-check is deliberately disabled in 1.3.0.
        # F7 now runs an external, interactive Hunspell check.
        self.inline_spell_enabled = False
        self._opacity_widget_api = Gtk.Widget

        self.spell_source = None
        self.word_count_source = None
        self._wrap_reflow_source = None
        self.focus_mode = False
        self.typewriter_mode = False
        self.current_line_highlight = False
        self.distraction_free = False
        self.bookmarks = []

        self.set_default_size(width, height)
        # Mature GTK editors use a default size plus WM geometry hints; they do
        # not export a GtkWidget size request from the top-level window.  A
        # positive Gtk.Window size request can keep the initial natural width
        # authoritative after a side panel is attached and make interactive
        # shrinking appear locked.  The minimum remains owned solely by
        # apply_window_geometry_hints(); child scrollers contain content growth.
        self.apply_window_geometry_hints()
        self.set_resizable(True)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(self.always_on_top)
        apply_widget_opacity(self, self.opacity_percent, widget_api=self._opacity_widget_api)
        self.set_icon_name(APP_ICON)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.set_hexpand(True)
        root.set_vexpand(True)
        self.add(root)

        self.menubar = Gtk.MenuBar()
        root.pack_start(self.menubar, False, False, 0)
        self.menu_ui_adapter = ui_build_menu(self.menubar, self.invoke_command)

        self.workspace_paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.workspace_paned.set_hexpand(True)
        self.workspace_paned.set_vexpand(True)
        root.pack_start(self.workspace_paned, True, True, 0)

        self.body_paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.body_paned.set_hexpand(True)
        self.body_paned.set_vexpand(True)
        self.workspace_paned.pack2(self.body_paned, True, True)

        # Keep Gtk.TextView as the direct Gtk.ScrolledWindow child.
        # GTK's native caret/selection scrolling only works reliably in this
        # topology; the line-number gutter stays outside the scroller.
        self.editor_box, self.line_gutter, self.scroller, self.text = build_editor_widgets(self.word_wrap)
        self.body_paned.pack1(self.editor_box, True, True)

        overview_runtime_ref = SetOnceReference("document-overview-runtime")
        research_runtime_ref = SetOnceReference("research-application-runtime")
        def refresh_overview_if_ready():
            try:
                return overview_runtime_ref.require().refresh_if_open()
            except RuntimeError:
                return False

        core_components = compose_core_application_components(
            CoreApplicationCompositionInput(
                initial_file_path=self.persisted_application_state.last_file,
                workspace_root=(self.persisted_application_state.workspace_root if self.persisted_application_state.workspace_root and os.path.isdir(self.persisted_application_state.workspace_root) else None),
                workspace_visible=self.persisted_application_state.workspace_visible,
                text_view=self.text,
                scroller=self.scroller,
                workspace_paned=self.workspace_paned,
                body_paned=self.body_paned,
                dialog_parent=self,
                menu_ui_adapter=self.menu_ui_adapter,
                recent_workspaces=self.recent_workspace_store,
                recent_files=self.recent_file_store,
                favourites=self.favourite_store,
                application_state=self.application_state,
                config_dir=self.config_dir,
                read_buffer_text=self._read_buffer_text_raw,
                replace_buffer_text=self._replace_buffer_text_raw,
                reset_undo_history=self.reset_undo_history,
                on_typewriter_state_changed=self.on_typewriter_state_changed,
                on_buffer_changed=self.on_changed,
                on_buffer_begin_user_action=self.on_buffer_begin_user_action,
                on_buffer_end_user_action=self.on_buffer_end_user_action,
                on_cursor_position_notify=self.on_cursor_position_notify,
                on_text_key_press=self.on_text_key_press,
                on_text_key_release=self.on_text_key_release,
                on_text_move_cursor=self.on_text_move_cursor,
                on_text_button_press=self.on_text_button_press,
                on_text_motion_notify=self.on_text_motion_notify,
                on_text_button_release=self.on_text_button_release,
                on_text_scroll=self.on_text_scroll,
                on_text_focus_out=self.on_text_focus_out,
                apply_wrap_policy=self.apply_wrap_policy,
                queue_wrap_reflow=self.queue_wrap_reflow,
                may_continue=self.may_continue,
                open_document=self.open_path,
                report_error=self.error,
                document_text=self.buffer_text,
                research_context_changed=lambda: research_runtime_ref.require().research_document_context_changed(),
                update_title=self.update_title,
                refresh_overview=refresh_overview_if_ready,
                refresh_ui_state=self.refresh_ui_state,
                on_navigator_visibility_changed=lambda _visible: self.refresh_ui_state(),
                execute_command=self.execute_command,
                get_cursor_offset=self.get_cursor_offset,
                set_cursor_offset=self.set_cursor_offset,
                sync_history_view_state=self.sync_current_history_view_state,
                queue_insert_scroll=self.queue_insert_scroll,
                publish_invalidation=lambda *reasons: research_runtime_ref.require().publish_research_invalidation(*reasons),
                clip_invalidation_reason=ResearchInvalidationReason.CLIPS,
            )
        )

        # W101 compatibility ledger: exact 24 aliases, explicitly projected by
        # the concrete shell before Workspace startup binding.
        self.document_session = core_components.document_session.session
        self.document_session_controller = core_components.document_session.controller
        self.history = core_components.editor.history
        self.viewport_runtime = core_components.editor.viewport_runtime
        self.history_runtime = core_components.editor.history_runtime
        self.editor_transaction = core_components.editor_transaction.controller
        self.editor_buffer_adapter = core_components.editor_transaction.buffer_adapter
        self.typewriter_runtime = core_components.editor.typewriter_runtime
        self.search_controller = core_components.editor.search_controller
        self.tag = core_components.editor.misspelling_tag
        self.search_tag = core_components.editor.search_tag
        self.current_line_tag = core_components.editor.current_line_tag
        self.navigation_controller = core_components.navigator.navigation_controller
        self.left_panel_host = core_components.navigator.left_panel_host
        self.navigator_panel_view = core_components.navigator.panel_view
        self.navigator_panel_host = core_components.navigator.panel_host
        self.navigator_panel_runtime = core_components.navigator.panel_runtime
        self.workspace_controller = core_components.workspace.controller
        self.workspace_panel_view = core_components.workspace.panel_view
        self.workspace_application_runtime = core_components.workspace.application_runtime
        self.workspace_mutation_controller = core_components.workspace.mutation_controller
        self.workspace_mutation_runtime = core_components.workspace.mutation_runtime
        self.workspace_panel_host = core_components.workspace.panel_host
        self.workspace_panel_runtime = core_components.workspace.panel_runtime
        self.right_panel_host = core_components.right_panel_host
        self.clip_collection_view = core_components.clips.view
        self.clip_collection = core_components.clips.controller
        self.clip_collection_runtime = core_components.clips.runtime

        core_components = complete_core_application_components(
            core_components,
            (self.persisted_application_state.workspace_root if self.persisted_application_state.workspace_root and os.path.isdir(self.persisted_application_state.workspace_root) else None),
            self.persisted_application_state.workspace_visible,
        )
        self._components = core_components
        self._w107_subsystems = build_subsystem_host_components(
            SubsystemHostCompositionInput(
                dialog_parent=self,
                text_view=self.text,
                misspelling_tag=self.tag,
                search_controller=self.search_controller,
                editor_transaction=self.editor_transaction,
                editor_buffer_adapter=self.editor_buffer_adapter,
                document_text=self.buffer_text,
                language_provider=lambda: self.spell_lang,
                update_language=lambda lang: self.update_preferences(spell_lang=lang),
                show_info=self.info,
                show_error=self.error,
                update_title=self.update_title,
                project_committed_change=lambda label: self._project_committed_editor_change(command_name=label),
                font_provider=lambda: (self.font_family, self.font_size),
            )
        )
        self.build_research_panel()
        research_runtime_ref.set(self._research_components.runtime)
        dossier = document_dossier_app.build_document_overview(
            document_dossier_app.DocumentOverviewCompositionInput(
                dialog_parent=self,
                text_view=self.text,
                document_text=self.buffer_text,
                document_path=lambda: self.document.file_path,
                document_modified=lambda: self.modified,
                bookmarks=lambda: tuple(self.bookmarks),
                reference_store=self.reference_store,
                reference_set_store=self.reference_set_store,
                set_cursor_offset=self.set_cursor_offset,
                get_cursor_offset=self.get_cursor_offset,
                select_range=self.select_range,
                show_reference=self._research_components.runtime.show_reference_key,
                show_source_note=self._research_components.runtime.show_source_note_id,
                show_reference_set=partial(
                    document_dossier_app.show_reference_set_name,
                    self.research_panel_runtime.show,
                    self.reference_set_runtime.show_set,
                ),
                run_research_check=self._research_components.runtime.on_research_check,
                show_error=self.error,
                show_notice=self.info,
            )
        )
        self.document_dossier_controller = dossier.controller
        self.document_overview_runtime = dossier.runtime
        overview_runtime_ref.set(dossier.runtime)

        search_runtime = self._w107_subsystems.search
        spellcheck_runtime = self._w107_subsystems.spellcheck
        print_runtime = self._w107_subsystems.printer
        workspace_runtime = self._components.workspace.host_runtime
        research_runtime = self._research_components.runtime
        writing_insert_ports = writing_app.WritingInsertPorts(
            command_layer_insert_date_time_text=self.command_layer_insert_date_time_text,
            get_cursor_offset=self.get_cursor_offset,
            buffer_text=self.buffer_text,
            execute_command=self.execute_command,
        )
        self.command_actions = build_application_command_layer(
            ApplicationCommandPorts(
                edit=EditCommandPorts(
                    on_copy=self.on_copy,
                    on_cut=self.on_cut,
                    on_duplicate_line_or_selection=self.on_duplicate_line_or_selection,
                    on_find_all=search_runtime.on_find_all,
                    on_find_next=search_runtime.on_find_next,
                    on_find_previous=search_runtime.on_find_previous,
                    on_find_replace=search_runtime.on_find_replace,
                    on_lowercase=self.on_lowercase,
                    on_paste=self.on_paste,
                    on_paste_clean_pdf=self.on_paste_clean_pdf,
                    on_paste_plain_text=self.on_paste_plain_text,
                    on_redo=self.on_redo,
                    on_replace_all_dialog=search_runtime.on_find_replace,
                    on_select_all=self.on_select_all,
                    on_undo=self.on_undo,
                    on_uppercase=self.on_uppercase,
                    on_move_line=self.on_move_line,
                ),
                file=FileCommandPorts(
                    on_add_favourite=self.on_add_favourite,
                    on_edit_favourites=self.on_edit_favourites,
                    on_reload_favourites=self.on_reload_favourites,
                    on_new=self.on_new,
                    on_open=self.on_open,
                    on_print=print_runtime.on_print,
                    on_print_preview=print_runtime.on_print_preview,
                    on_quit=self.on_quit,
                    on_save=self.on_save,
                    on_save_as=self.on_save_as,
                    on_manage_templates=self.on_manage_templates,
                    on_save_as_template=self.on_save_as_template,
                    on_close_workspace=workspace_runtime.on_close_workspace,
                    on_duplicate_workspace_file=workspace_runtime.on_duplicate_workspace_file,
                    on_new_workspace_folder=workspace_runtime.on_new_workspace_folder,
                    on_new_workspace_text_file=workspace_runtime.on_new_workspace_text_file,
                    on_refresh_workspace=workspace_runtime.on_refresh_workspace,
                    on_rename_workspace_item=workspace_runtime.on_rename_workspace_item,
                    on_reveal_workspace=workspace_runtime.on_reveal_workspace,
                    on_select_workspace_folder=workspace_runtime.on_select_workspace_folder,
                    show_workspace_panel=workspace_runtime.show_workspace_panel,
                    on_move_workspace_item_to_trash=workspace_runtime.on_move_workspace_item_to_trash,
                    on_new_from_template=self.on_new_from_template,
                    open_recent_path=self.open_recent_path,
                    open_favourite_path=self.open_favourite_path,
                    activate_workspace_path=workspace_runtime.activate_workspace_path,
                    open_path=self.open_path,
                    may_continue=self.may_continue,
                    on_clear_recent=self.on_clear_recent,
                ),
                help=HelpCommandPorts(
                    on_about=self.on_about,
                    on_keyboard_shortcuts=self.on_keyboard_shortcuts,
                    on_user_guide=self.on_user_guide,
                ),
                navigate=NavigateCommandPorts(
                    on_manage_bookmarks=self.on_manage_bookmarks,
                    next_bookmark=self.next_bookmark,
                    previous_bookmark=self.previous_bookmark,
                    toggle_bookmark=self.toggle_bookmark,
                    on_document_overview=self.document_overview_runtime.open,
                    on_go_to_line=self.on_go_to_line,
                    on_go_to_section=self.on_go_to_section,
                    on_next_heading=self.on_next_heading,
                    on_previous_heading=self.on_previous_heading,
                    on_navigator_item_toggled=lambda item: self.navigator_panel_runtime.set_visible(bool(item.get_active())),
                    toggle_navigator_panel=self.navigator_panel_runtime.toggle,
                    on_workspace_item_toggled=workspace_runtime.on_workspace_item_toggled,
                    toggle_workspace_panel=workspace_runtime.toggle_workspace_panel,
                ),
                options=OptionsCommandPorts(
                    on_font=self.on_font,
                    on_opacity_selection=self.on_opacity_selection,
                    change_font=self.change_font,
                    set_opacity_value=self.set_opacity_value,
                    on_word_wrap=self.on_word_wrap,
                    toggle_word_wrap=self.toggle_word_wrap,
                    on_transparent_mode=self.on_transparent_mode,
                    toggle_transparent_mode=self.toggle_transparent_mode,
                    on_top=self.on_top,
                    toggle_always_on_top=self.toggle_always_on_top,
                    on_line_numbers=self.on_line_numbers,
                    toggle_line_numbers=self.toggle_line_numbers,
                    on_white_background=self.on_white_background,
                    on_dark_mode=self.on_dark_mode,
                ),
                research=ResearchCommandPorts(
                    show_authoring_bridge=research_runtime.show_authoring_bridge,
                    show_references=research_runtime.show_references,
                    on_capture_selection_in_scratchpad=research_runtime.on_capture_selection_in_scratchpad,
                    on_research_check=research_runtime.on_research_check,
                    show_clip_collection=research_runtime.show_clip_collection,
                    on_create_source_note_from_selection=research_runtime.on_create_source_note_from_selection,
                    on_export_research_apparatus=research_runtime.on_export_research_apparatus,
                    on_export_references_bibtex_biblatex=research_runtime.on_export_references_bibtex_biblatex,
                    on_export_bibliography_markdown=research_runtime.on_export_bibliography_markdown,
                    on_export_bibliography_text=research_runtime.on_export_bibliography_text,
                    on_export_with_pandoc=research_runtime.on_export_with_pandoc,
                    on_import_bibtex_biblatex=research_runtime.on_import_bibtex_biblatex,
                    on_insert_clip=research_runtime.on_insert_clip,
                    on_insert_link_to_heading=research_runtime.on_insert_link_to_heading,
                    on_new_scratchpad_for_current_section=research_runtime.on_new_scratchpad_for_current_section,
                    on_open_bibliography_file=research_runtime.on_open_bibliography_file,
                    on_open_citation_in_references=research_runtime.on_open_citation_in_references,
                    on_quick_cite=research_runtime.on_quick_cite,
                    show_reference_sets=research_runtime.show_reference_sets,
                    on_rename_reference_key=research_runtime.on_rename_reference_key,
                    show_scratchpad=research_runtime.show_scratchpad,
                    on_show_scratchpad_for_current_section=research_runtime.on_show_scratchpad_for_current_section,
                    show_source_notes=research_runtime.show_source_notes,
                    on_tag_integrity=research_runtime.on_tag_integrity,
                    show_tags=research_runtime.show_tags,
                    insert_clip_number=research_runtime.insert_clip_number,
                    on_research_item_toggled=research_runtime.on_research_item_toggled,
                    toggle_research_panel=research_runtime.toggle_research_panel,
                ),
                tools=ToolsCommandPorts(
                    on_language_selection=self.on_language_selection,
                    on_check=spellcheck_runtime.on_check,
                    on_system_info=self.on_system_info,
                ),
                view=ViewCommandPorts(
                    on_character_map=partial(
                        present_character_map,
                        self,
                        self.text,
                        replace_selection=self.replace_selection,
                        execute_command=self.execute_command,
                    ),
                    toggle_current_line_highlight=self.toggle_current_line_highlight,
                    toggle_distraction_free=self.toggle_distraction_free,
                    toggle_focus_mode=self.toggle_focus_mode,
                ),
                writing=WritingCommandPorts(
                    on_clean_selected_pdf=self.on_clean_selected_pdf,
                    on_insert_date=partial(writing_app.on_insert_date, writing_insert_ports),
                    on_insert_datetime=partial(writing_app.on_insert_datetime, writing_insert_ports),
                    on_insert_time=partial(writing_app.on_insert_time, writing_insert_ports),
                    on_join_lines=self.on_join_lines,
                    on_reflow_paragraph=self.on_reflow_paragraph,
                    on_remove_extra_spaces=self.on_remove_extra_spaces,
                    on_remove_trailing_spaces=self.on_remove_trailing_spaces,
                    on_sentence_case=self.on_sentence_case,
                    on_smart_typography=self.on_smart_typography,
                    on_document_statistics=self.on_document_statistics,
                    on_title_case=self.on_title_case,
                    on_sort_lines_descending=self.on_sort_lines_descending,
                    on_sort_lines_ascending=self.on_sort_lines_ascending,
                    on_typewriter_item_toggled=partial(typewriter_app.on_typewriter_item_toggled, self.typewriter_runtime),
                    toggle_typewriter_mode=partial(typewriter_app.toggle_typewriter_mode, self.typewriter_runtime),
                ),
            )
        )
        self.ui_state_components = build_ui_state_components(
            UiStateCompositionInput(self.command_actions.availability)
        )
        self.ui_state_controller = self.ui_state_components.controller
        self.ui_state_controller.bind_projector(self.menu_ui_adapter)
        self.populate_template_menu()
        self.populate_recent_menu()
        self.populate_favourites_menu()
        self._components.workspace.host_runtime.populate_recent_workspaces_menu()

        # Both side panels start detached. The editor remains the only visible
        # workspace client until the user explicitly requests a panel.
        self.workspace_paned.set_position(0)
        self.body_paned.set_position(max(420, int(width * 0.72)))
        self.configure_application_lifecycle()

        self.status = Gtk.Label()
        self.status.set_xalign(0)
        # Xed and FeatherPad keep status information semantic and bounded.
        # The full document path belongs in the window title/tooltip, not in a
        # non-ellipsized status label that can become the GtkWindow minimum.
        self.status.set_ellipsize(Pango.EllipsizeMode.END)
        self.status.set_single_line_mode(True)
        self.status.set_max_width_chars(72)
        self.status.set_size_request(1, -1)
        self.status.set_hexpand(True)
        self.status.set_margin_start(8)
        self.status.set_margin_end(8)
        self.status.set_margin_top(3)
        self.status.set_margin_bottom(3)
        root.pack_end(self.status, False, False, 0)

        self.css = Gtk.CssProvider()
        self.apply_font()

        ui_add_shortcuts(self, self.invoke_command)
        self.setup_file_drop_target()
        self.connect("delete-event", self.on_close)
        self.connect("destroy", self.on_destroy)
        self._application_close_in_progress = False

        if self.current_file and os.path.exists(self.current_file):
            self.open_path(self.current_file, silent=True)
        else:
            self.reset_undo_history()

        if self._components.workspace.startup_visible:
            self.workspace_panel_runtime.set_visible(True)
        self.refresh_ui_state()
        self.update_title()

    @property
    def document(self):
        return self.document_session.document

    @property
    def current_file(self):
        return self.document_session.file_path

    @property
    def modified(self):
        return self.document_session.modified

    @property
    def loading(self):
        return self.document_session.loading

    @property
    def restoring_undo(self):
        transaction = getattr(self, "editor_transaction", None)
        return bool(transaction and transaction.restoring)

    def _read_buffer_text_raw(self):
        b = self.text.get_buffer()
        s, e = b.get_bounds()
        return b.get_text(s, e, True)

    def _replace_buffer_text_raw(self, text):
        self.text.get_buffer().set_text(text)

    def apply_window_geometry_hints(self):
        """Apply minimum geometry only.

        Calamus must never use max-size hints or resize itself from
        size-allocate. Those policies can make the top-level window expand to
        monitor bounds after large paste/Enter-heavy documents and can prevent
        normal WM resizing from the top edge. Document growth belongs inside
        Gtk.ScrolledWindow, not in Gtk.Window geometry.
        """
        try:
            geometry = Gdk.Geometry()
            geometry.min_width = MIN_WINDOW_WIDTH
            geometry.min_height = MIN_WINDOW_HEIGHT
            self.set_geometry_hints(None, geometry, Gdk.WindowHints.MIN_SIZE)
        except Exception as exc:
            log_nonfatal("window geometry hints failed", exc)

    def apply_wrap_policy(self):
        """Apply soft wrap against the actual editor viewport width."""
        if not hasattr(self, "scroller") or not hasattr(self, "text"):
            return False
        apply_text_wrap_policy(self.text, self.scroller, bool(getattr(self, "word_wrap", True)))
        if hasattr(self, "editor_box"):
            self.editor_box.queue_resize()
        return False

    def queue_wrap_reflow(self):
        self.apply_wrap_policy()
        if hasattr(self, "workspace_paned"):
            self.workspace_paned.queue_resize()
        if hasattr(self, "body_paned"):
            self.body_paned.queue_resize()
        source = self._wrap_reflow_source
        self._wrap_reflow_source = None
        if source is not None:
            try:
                GLib.source_remove(source)
            except Exception:
                pass

        def apply_deferred():
            self._wrap_reflow_source = None
            return self.apply_wrap_policy()

        self._wrap_reflow_source = GLib.idle_add(apply_deferred)

    def on_cursor_position_notify(self, *_):
        # Do not auto-scroll on every cursor-position notification. Mouse clicks
        # produce this signal too, and forcing scroll here caused the document to
        # jump down by blocks when selecting/pointing at a word.
        self.update_current_line_highlight()
        if hasattr(self, "navigator_panel_view"):
            self.navigator_panel_view.schedule_cursor_sync()

    def on_text_key_press(self, widget, event):
        return typewriter_app.on_text_key_press(self.typewriter_runtime, widget, event)

    def on_text_key_release(self, widget, event):
        return typewriter_app.on_text_key_release(self.typewriter_runtime, widget, event)

    def on_text_move_cursor(self, *_args):
        return typewriter_app.on_text_move_cursor(
            self.typewriter_runtime, self.viewport_runtime, *_args
        )

    def on_text_button_press(self, widget, event):
        return typewriter_app.on_text_button_press(self.typewriter_runtime, widget, event)

    def on_text_motion_notify(self, widget, event):
        return typewriter_app.on_text_motion_notify(self.typewriter_runtime, widget, event)

    def on_text_button_release(self, widget, event):
        return typewriter_app.on_text_button_release(self.typewriter_runtime, widget, event)

    def on_text_scroll(self, widget, event):
        return typewriter_app.on_text_scroll(self.typewriter_runtime, widget, event)

    def on_text_focus_out(self, widget, event):
        return typewriter_app.on_text_focus_out(self.typewriter_runtime, widget, event)

    def on_buffer_begin_user_action(self, *_):
        enabled = not self.loading and not self.restoring_undo
        accepted = self.editor_transaction.begin_user_action(enabled)
        if accepted:
            self.typewriter_runtime.on_begin_user_action()

    def on_buffer_end_user_action(self, *_):
        enabled = not self.loading and not self.restoring_undo
        accepted = self.editor_transaction.end_user_action(enabled)
        if accepted:
            self.typewriter_runtime.on_end_user_action()

    def queue_insert_scroll(self, margin=0.02, *, center_if_outside=False):
        if self.viewport_runtime is None:
            return False
        if self.typewriter_runtime.enabled:
            return self.typewriter_runtime.on_structural_navigation()
        return self.viewport_runtime.queue_visible_to_insert(
            margin, center_if_outside=center_if_outside
        )

    def ensure_insert_visible(self, margin=0.02, *, center_if_outside=False):
        return self.queue_insert_scroll(
            margin, center_if_outside=center_if_outside
        )

    def setup_file_drop_target(self):
        targets = [Gtk.TargetEntry.new("text/uri-list", 0, 0)]
        for widget in (self, self.text):
            widget.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.COPY)
            widget.connect("drag-data-received", self.on_drag_data_received)

    def on_drag_data_received(self, widget, context, x, y, data, info, time):
        opened = False
        try:
            for uri in data.get_uris() if data is not None else []:
                parsed = GLib.filename_from_uri(uri)
                path = parsed[0] if parsed else None
                if path and os.path.isfile(path):
                    result = self.invoke_command(
                        "file.open-drop", source="drop", data={"path": path}
                    )
                    opened = bool(result.success and result.value)
                    break
        except Exception as e:
            self.error(str(e))
        Gtk.drag_finish(context, opened, False, time)
        return True

    @property
    def config_dir(self):
        return self.persistence.config_dir

    @property
    def preference_snapshot(self):
        return self.preferences.current

    @property
    def persisted_application_state(self):
        return self.application_state.current

    @property
    def font_family(self):
        return self.preference_snapshot.font_family

    @property
    def font_size(self):
        return self.preference_snapshot.font_size

    @property
    def word_wrap(self):
        return self.preference_snapshot.word_wrap

    @property
    def always_on_top(self):
        return self.preference_snapshot.always_on_top

    @property
    def spell_lang(self):
        return self.preference_snapshot.spell_lang

    @property
    def appearance_mode(self):
        return self.preference_snapshot.appearance_mode

    @property
    def opacity_percent(self):
        return self.preference_snapshot.opacity_percent

    @property
    def line_numbers_enabled(self):
        return self.preference_snapshot.line_numbers

    @property
    def trim_trailing_on_save(self):
        return self.preference_snapshot.trim_trailing_on_save

    @property
    def print_pages(self):
        hosts = getattr(self, "_w107_subsystems", None)
        return list(hosts.printer.pages) if hosts is not None else []

    @property
    def workspace_root(self):
        runtime = getattr(self, "workspace_application_runtime", None)
        if runtime is not None:
            return runtime.root
        return self.persisted_application_state.workspace_root

    @property
    def workspace_visible(self):
        runtime = getattr(self, "workspace_panel_runtime", None)
        if runtime is not None:
            return bool(runtime.is_visible)
        return self.persisted_application_state.workspace_visible

    def _project_preferences_snapshot(self, _snapshot):
        self.set_keep_above(self.always_on_top)
        self.apply_opacity_percent(self.opacity_percent)
        self.apply_font()
        self.queue_wrap_reflow()
        if hasattr(self, "line_gutter"):
            self.update_line_numbers(force=True)
        self.refresh_ui_state()
        self.update_title()

    def update_preferences(self, **changes):
        try:
            result = self.preferences.update(
                project=self._project_preferences_snapshot,
                **changes,
            )
        except (OSError, PreferenceProjectionError, TypeError, ValueError) as exc:
            self.refresh_ui_state()
            self.error(str(exc))
            return False
        if not result.changed:
            self.refresh_ui_state()
            return False
        return True

    def record_window_geometry(self):
        width, height = self.get_size()
        return self.application_state.record_window_geometry(width, height)

    def record_last_file(self):
        return self.application_state.record_last_file(self.current_file)

    def invoke_command(self, command_id, *, source="gui", data=None):
        """Invoke one stable W104 user command through explicit application bindings."""
        if self.command_actions is None:
            raise RuntimeError("application command bindings are not composition-complete")
        return self.command_actions.dispatch(
            command_id,
            CommandContext(source=source, data=dict(data or {})),
        )

    def ui_state_facts(self):
        research_runtime = getattr(self, "research_panel_runtime", None)
        navigator_runtime = getattr(self, "navigator_panel_runtime", None)
        workspace_runtime = getattr(self, "workspace_panel_runtime", None)
        typewriter_runtime = getattr(self, "typewriter_runtime", None)
        return UiStateFacts(
            research_panel_visible=bool(getattr(research_runtime, "is_visible", False)),
            navigator_panel_visible=bool(getattr(navigator_runtime, "is_visible", False)),
            workspace_panel_visible=bool(getattr(workspace_runtime, "is_visible", False)),
            typewriter_enabled=bool(getattr(typewriter_runtime, "enabled", self.typewriter_mode)),
            word_wrap=bool(self.word_wrap),
            opacity_percent=int(self.opacity_percent),
            always_on_top=bool(self.always_on_top),
            appearance_mode=str(self.appearance_mode),
            line_numbers_enabled=bool(self.line_numbers_enabled),
            workspace_root_present=bool(self.workspace_root),
        )

    def refresh_ui_state(self):
        if self.ui_state_controller is None:
            return False
        return self.ui_state_controller.refresh(self.ui_state_facts())

    def buffer_text(self):
        return self.document_session_controller.capture_buffer_text()

    def set_buffer(self, text, *, modified=False):
        return self.document_session_controller.replace_current_text(
            text, modified=modified
        )

    def reset_undo_history(self):
        transaction = getattr(self, "editor_transaction", None)
        if transaction is not None:
            transaction.reset()
        else:
            self.history_runtime.reset()
        typewriter_runtime = getattr(self, "typewriter_runtime", None)
        if typewriter_runtime is not None:
            typewriter_runtime.on_document_replaced()

    def schedule_undo_snapshot(self):
        self.editor_transaction.schedule_native_snapshot(
            not self.loading and not self.restoring_undo
        )

    def commit_undo_snapshot(self):
        self.editor_transaction.flush()
        return False

    def commit_pending_undo(self):
        self.editor_transaction.flush()

    def _invalidate_editor_views(self):
        if hasattr(self, "document_overview_runtime"):
            self.document_overview_runtime.mark_stale()
        if hasattr(self, "navigation_controller"):
            self.navigation_controller.invalidate()
        if hasattr(self, "navigator_panel_view"):
            self.navigator_panel_view.invalidate()
        self.update_line_numbers()

    def _project_committed_editor_change(self, *, command_name=None):
        self._invalidate_editor_views()
        if command_name is not None:
            self.last_command = command_name
        self.schedule_status_update()
        self.schedule_search_highlight()
        self.update_current_line_highlight()
        if self.typewriter_runtime.enabled:
            self.typewriter_runtime.on_edit()
        else:
            self.viewport_runtime.queue_visible_to_insert(0.02)
        self._research_components.runtime.publish_research_invalidation(
            ResearchInvalidationReason.DOCUMENT_CONTENT
        )
        self.update_title()

    def _project_history_restore(self):
        if self.typewriter_runtime.enabled:
            self.typewriter_runtime.on_history()
        else:
            self.viewport_runtime.queue_visible_to_insert(
                0.15, center_if_outside=True
            )
        self.schedule_status_update()
        self.schedule_search_highlight()
        self.update_line_numbers()
        self.update_title()

    def finalize_command_edit(self, select_range=None, command_name="Edit"):
        result = self.editor_transaction.finalize_prepared_command(
            command_name, select_range=select_range
        )
        if result.changed:
            self._project_committed_editor_change(command_name=command_name)
        return result.changed

    def execute_command(self, command_name, edit_func, select_range=None):
        """Run one atomic logical edit through the W103 transaction authority."""
        result = self.editor_transaction.execute_command(
            command_name, edit_func, select_range=select_range
        )
        if result.changed:
            self._project_committed_editor_change(command_name=command_name)
        return result.changed

    def perform_buffer_edit(self, edit_func, select_range=None, command_name="Edit"):
        return self.execute_command(command_name, edit_func, select_range=select_range)

    def set_text_from_history(self, state):
        if not isinstance(state, HistoryState):
            raise TypeError("Undo/Redo restoration requires HistoryState")
        result = self.editor_transaction.restore_history_state(
            state, label="History Restore"
        )
        self._project_history_restore()
        return result.changed

    def on_undo(self, *_):
        """UI callback: apply Undo when available; success is effect-based."""
        result = self.editor_transaction.undo()
        if result is None:
            if self.history.disabled_reason:
                self.status.set_text(self.history.disabled_reason)
            return
        self._project_history_restore()

    def on_redo(self, *_):
        """UI callback: apply Redo when available; success is effect-based."""
        result = self.editor_transaction.redo()
        if result is None:
            if self.history.disabled_reason:
                self.status.set_text(self.history.disabled_reason)
            return
        self._project_history_restore()

    def on_changed(self, *_):
        change_kind = self.editor_transaction.observe_buffer_change()
        if change_kind is EditorChangeKind.PROGRAMMATIC:
            return
        if change_kind is EditorChangeKind.REPLACEMENT:
            # Open/New/Undo replacement still invalidates structure and gutter,
            # but must not create history or dirty-state transitions.
            self._invalidate_editor_views()
            return
        self._project_committed_editor_change()

    def on_opacity_selection(self, *_):
        d = Gtk.Dialog(title="Opacity", transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL)
        box = d.get_content_area()
        box.set_spacing(8)
        box.set_margin_start(12); box.set_margin_end(12); box.set_margin_top(12); box.set_margin_bottom(12)
        label = Gtk.Label(label="Choose a fixed opacity value:")
        label.set_xalign(0)
        box.pack_start(label, False, False, 0)
        grid = Gtk.Grid(column_spacing=6, row_spacing=6)
        vals = [30, 40, 50, 60, 70, 80, 88, 90, 100]
        for i, val in enumerate(vals):
            b = Gtk.Button(label=f"{val}%")
            b.set_size_request(58, 28)
            b.connect("clicked", lambda _w, v=val: (self.invoke_command("options.opacity.set", source="dialog", data={"percent": v}), d.response(Gtk.ResponseType.CANCEL)))
            grid.attach(b, i % 3, i // 3, 1, 1)
        box.pack_start(grid, False, False, 0)
        d.show_all(); d.run(); d.destroy()

    def installed_hunspell_languages(self):
        names = []
        for base in ("/usr/share/hunspell", "/usr/share/myspell/dicts"):
            try:
                for fn in os.listdir(base):
                    if fn.endswith(".dic"):
                        lang = fn[:-4]
                        if lang not in names:
                            names.append(lang)
            except OSError:
                pass
        preferred = [x for x in ("it_IT", "it", "en_US", "en_GB", "en") if x in names]
        rest = sorted(x for x in names if x not in preferred)
        return preferred + rest

    def on_language_selection(self, *_):
        d = Gtk.Dialog(title="Language", transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Apply", Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(6)
        box.set_margin_start(12); box.set_margin_end(12); box.set_margin_top(12); box.set_margin_bottom(12)
        langs = self.installed_hunspell_languages() or [self.spell_lang]
        group = None
        buttons = []
        for lang in langs:
            rb = Gtk.RadioButton.new_with_label_from_widget(group, lang) if group else Gtk.RadioButton.new_with_label(None, lang)
            if group is None:
                group = rb
            rb.set_active(lang == self.spell_lang)
            box.pack_start(rb, False, False, 0)
            buttons.append((lang, rb))
        note = Gtk.Label(label="Install missing dictionaries with your system package manager, e.g. hunspell-it or hunspell-en-us.")
        note.set_xalign(0); note.set_line_wrap(True)
        box.pack_start(note, False, False, 8)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK:
            for lang, rb in buttons:
                if rb.get_active():
                    self.update_preferences(spell_lang=lang)
                    break
        d.destroy()

    def runtime_identity(self):
        return build_runtime_identity(
            DEVELOPMENT_BUILD_LABEL,
            DEVELOPMENT_WORK_ITEM,
            PUBLISHED_BASELINE,
            work_item_description=DEVELOPMENT_WORK_ITEM_DESCRIPTION,
        )

    def system_info_snapshot(self):
        import platform

        dictionaries = (
            ", ".join(self.installed_hunspell_languages()[:20])
            or "none found"
        )
        return SystemInfoSnapshot(
            identity=self.runtime_identity(),
            python_version=platform.python_version(),
            pygobject_version=getattr(gi, "__version__", "unknown"),
            gtk_version=(
                f"{Gtk.MAJOR_VERSION}.{Gtk.MINOR_VERSION}.{Gtk.MICRO_VERSION}"
            ),
            operating_system=platform.platform(),
            desktop=os.environ.get("XDG_CURRENT_DESKTOP", "unknown"),
            session=os.environ.get("XDG_SESSION_TYPE", "unknown"),
            config_path=str(self.config_dir),
            hunspell_dictionaries=dictionaries,
        )

    def on_system_info(self, *_):
        present_system_info_dialog(
            self,
            render_system_info(self.system_info_snapshot()),
        )

    def update_title(self):
        name = self.current_file or "Untitled"
        visible_name = os.path.basename(self.current_file) if self.current_file else "Untitled"
        status = "not saved" if self.modified else "saved"
        mark = " *" if self.modified else ""
        self.set_title(f"{APP_TITLE} - {name} ({status})")
        lang = self.spell_lang.upper()
        top_active = bool(self.always_on_top)
        top = "top ON" if top_active else "top OFF"
        bg = {APPEARANCE_DARK: "dark bg", APPEARANCE_LIGHT: "white bg"}.get(self.appearance_mode, "default bg")
        words, chars, lines = self.text_stats()
        ln = "lines ON" if self.line_numbers_enabled else "lines OFF"
        tw = "typewriter ON" if self.typewriter_mode else "typewriter OFF"
        undo_note = " | undo limited" if getattr(self.history, "disabled_reason", None) else ""
        visible_status = f"{visible_name}{mark} | words {words} | chars {chars} | lines {lines} | font {self.font_size}pt | {lang} | {top} | {bg} | {ln} | {tw}{undo_note}"
        full_status = f"{name}{mark} | words {words} | chars {chars} | lines {lines} | font {self.font_size}pt | {lang} | {top} | {bg} | {ln} | {tw}{undo_note}"
        self.status.set_text(visible_status)
        self.status.set_tooltip_text(full_status)

    def apply_opacity_percent(self, percent):
        apply_widget_opacity(self, percent, widget_api=self._opacity_widget_api)

    def apply_font(self):
        css = build_application_css(
            self.font_family,
            self.font_size,
            self.appearance_mode,
        )
        install_application_css(
            self.css,
            Gdk.Screen.get_default(),
            css,
            style_context=Gtk.StyleContext,
            priority=Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
        apply_current_line_tag_style(self.current_line_tag, self.text, self.appearance_mode, settings_api=Gtk.Settings)
        if hasattr(self, "line_gutter"):
            self.line_gutter.apply_typography(
                self.font_family,
                self.font_size,
                pango=Pango,
            )
            self.update_line_numbers()
        self.update_title()

    def ask_save(self):
        return dialog_ask_save(self, self.document_session.requires_save_confirmation())

    def may_continue(self):
        r = self.ask_save()
        if r == "cancel":
            return False
        if r == "save":
            return self.save_file()
        return True

    def configure_application_lifecycle(self):
        return application_lifecycle_app.configure_application_lifecycle(
            self.application_lifecycle,
            pandoc_shutdown=self.pandoc_export_runtime.shutdown,
            shutdown_sources=self.shutdown_application_sources,
            navigator_shutdown=self.navigator_panel_runtime.shutdown,
            research_view_shutdown=self.research_panel_view.shutdown,
            research_coordinator_shutdown=self.research_coordinator.shutdown,
            document_overview_shutdown=self.document_overview_runtime.shutdown,
            typewriter_shutdown=self.typewriter_runtime.shutdown,
            history_shutdown=self.history_runtime.shutdown,
            viewport_shutdown=self.viewport_runtime.shutdown,
        )

    def shutdown_application_sources(self):
        source_ids = (self.spell_source, self.word_count_source, self._wrap_reflow_source)
        self.spell_source = None
        self.word_count_source = None
        self._wrap_reflow_source = None
        return application_lifecycle_app.shutdown_application_sources(
            source_ids,
            GLib.source_remove,
            self.search_controller.cancel_pending_highlight,
        )

    def request_application_close(self):
        # Every interactive close path owns the decision, then delegates all
        # runtime ownership to the single W99 lifecycle coordinator.
        if getattr(self, "_application_close_in_progress", False):
            return True
        if not self.may_continue():
            return False
        report = self.application_lifecycle.preflight()
        if not report.ok:
            failure = report.failures[0]
            self.error(
                "Application shutdown was blocked; Calamus remains open.\n"
                f"{failure.owner}: {failure.detail}"
            )
            return False
        if not self.record_window_geometry():
            log_nonfatal("application-state geometry persistence failed", OSError("settings write failed"))
        if not self.record_last_file():
            log_nonfatal("application-state last-file persistence failed", OSError("settings write failed"))
        self._application_close_in_progress = True
        try:
            self.destroy()
        except Exception:
            self._application_close_in_progress = False
            raise
        return True

    def on_destroy(self, *_):
        report = self.application_lifecycle.shutdown()
        for failure in report.failures:
            log_nonfatal(
                f"application lifecycle shutdown failed: {failure.owner}",
                RuntimeError(failure.detail),
            )
        # Calamus currently has one top-level application window. While the
        # launcher still owns a raw Gtk.main() loop, destroying that final
        # window must terminate the loop exactly once.
        if Gtk.main_level() > 0:
            Gtk.main_quit()
        return False

    def on_close(self, *_):
        self.request_application_close()
        return True

    def on_quit(self, *_):
        return self.request_application_close()

    def on_new(self, *_):
        if not self.may_continue():
            return
        self.execute_new_plan(prepare_new_plan())

    def execute_new_plan(self, plan):
        # The controller commits identity only after Gtk accepts the text.
        self.document_session_controller.execute_new(plan)
        self.application_state.record_last_file(self.current_file)
        self._research_components.runtime.research_document_context_changed()
        self.document_overview_runtime.refresh_if_open()
        if hasattr(self, "workspace_panel_view") and self.current_file:
            self.workspace_panel_view.select_path(self.current_file)
        self.update_title()
        return True

    def on_open(self, *_):
        if not self.may_continue():
            return
        path = choose_open_file(self)
        if path:
            self.open_path(path)

    def open_path(self, path, silent=False):
        try:
            plan, _transition = self.document_session_controller.open_path(path)
            return self.finalize_open_transition(plan, silent=silent)
        except (OSError, UnicodeError, TypeError, ValueError) as e:
            if not silent:
                self.error(str(e))
            return False

    def execute_open_plan(self, plan, silent=False):
        self.document_session_controller.execute_open(plan)
        return self.finalize_open_transition(plan, silent=silent)

    def finalize_open_transition(self, plan, silent=False):
        self.add_recent_file(self.current_file)
        self._research_components.runtime.research_document_context_changed()
        self.document_overview_runtime.refresh_if_open()
        if hasattr(self, "workspace_panel_view") and self.current_file:
            self.workspace_panel_view.select_path(self.current_file)
        self.update_title()
        self.application_state.record_last_file(self.current_file)
        if plan.large_file and not silent:
            self.info("Large file mode", f"This file is larger than {LARGE_FILE_BYTES // 1_000_000} MB. Undo history is limited to keep Calamus responsive.")
        return True

    def on_save(self, *_):
        self.save_file()

    def on_save_as(self, *_):
        self.save_as()

    def save_file(self):
        plan = prepare_save_plan(
            self.current_file,
            self.buffer_text(),
            trim_trailing_on_save=getattr(self, "trim_trailing_on_save", False),
        )
        if plan.requires_destination:
            return self.save_as()
        return self.execute_save_plan(plan)

    def execute_save_plan(self, plan):
        previous_path = self.current_file
        try:
            self.document_session_controller.execute_save(plan)
            self.add_recent_file(self.current_file)
            if previous_path != self.current_file:
                self._research_components.runtime.research_document_context_changed()
            elif plan.replaces_buffer_text:
                self._research_components.runtime.publish_research_invalidation(
                    ResearchInvalidationReason.DOCUMENT_CONTENT
                )
            self.update_title()
            self.application_state.record_last_file(self.current_file)
            self.document_overview_runtime.refresh_if_open()
            return True
        except (OSError, ValueError) as e:
            self.error(str(e))
            return False

    def save_as(self):
        plan = prepare_save_as_plan(
            choose_save_file(self),
            self.buffer_text(),
            trim_trailing_on_save=getattr(self, "trim_trailing_on_save", False),
        )
        if plan is None:
            return False
        return self.execute_save_plan(plan)

    def get_cursor_offset(self):
        buf = self.text.get_buffer()
        mark = buf.get_insert()
        it = buf.get_iter_at_mark(mark)
        return it.get_offset()

    def set_cursor_offset(self, offset):
        try:
            buf = self.text.get_buffer()
            it = buf.get_iter_at_offset(max(0, int(offset)))
            buf.place_cursor(it)
            self.queue_insert_scroll(margin=0.15)
        except Exception as exc:
            log_nonfatal("non-fatal GTK operation failed", exc)

    def sync_current_history_view_state(self):
        return self.history_runtime.sync_current_view_state()

    def on_top(self, item):
        return self.update_preferences(always_on_top=bool(item.get_active()))

    def on_white_background(self, item):
        requested = APPEARANCE_LIGHT if item.get_active() else APPEARANCE_SYSTEM
        return self.update_preferences(appearance_mode=requested)

    def on_dark_mode(self, item):
        requested = APPEARANCE_DARK if item.get_active() else APPEARANCE_SYSTEM
        return self.update_preferences(appearance_mode=requested)

    def on_line_numbers(self, item):
        return self.update_preferences(line_numbers=bool(item.get_active()))

    def set_opacity_value(self, v):
        try:
            requested = int(v)
        except (TypeError, ValueError):
            self.error("Opacity percent must be an integer.")
            return False
        return self.update_preferences(opacity_percent=requested)

    def change_font(self, delta):
        requested = max(MIN_FONT, min(MAX_FONT, self.font_size + int(delta)))
        return self.update_preferences(font_size=requested)

    def replace_selection(self, transform, command_name="Replace Selection"):
        b = self.text.get_buffer()
        if not b.get_has_selection():
            return False
        s, e = b.get_selection_bounds()
        start = s.get_offset()
        end = e.get_offset()
        txt = b.get_text(s, e, True)
        use_layer_uppercase = (
            command_name in {"Uppercase", "Upper Case", "UPPERCASE"}
            or transform is str.upper
        )
        use_layer_lowercase = (
            command_name in {"Lowercase", "Lower Case", "LOWERCASE"}
            or transform is str.lower
        )
        if use_layer_uppercase:
            replacement, changed = self.command_layer_uppercase_text(txt)
            if not changed:
                return False
        elif use_layer_lowercase:
            replacement, changed = self.command_layer_lowercase_text(txt)
            if not changed:
                return False
        else:
            replacement = transform(txt)
        _, select = command_replace_range(self.buffer_text(), start, end, replacement)
        def edit(buf):
            it1 = buf.get_iter_at_offset(start)
            it2 = buf.get_iter_at_offset(end)
            buf.delete(it1, it2)
            buf.insert(buf.get_iter_at_offset(start), replacement)
        return self.execute_command(command_name, edit, select_range=select)

    def selected_or_all_range(self):
        b = self.text.get_buffer()
        if b.get_has_selection():
            s, e = b.get_selection_bounds()
            return s.get_offset(), e.get_offset()
        s, e = b.get_bounds()
        return s.get_offset(), e.get_offset()

    def command_layer_uppercase_text(self, text):
        # Compute uppercase text through CommandLayer without mutating Gtk.TextBuffer.
        result = self.command_layer.dispatch(
            "edit.uppercase",
            CommandContext(source="gui", data={"text": text}),
        )
        if result.success and isinstance(result.value, dict):
            transformed = result.value.get("text", text)
        elif result.success:
            transformed = result.value
        else:
            return text, False
        if not isinstance(transformed, str):
            return text, False
        return transformed, transformed != text
    def command_layer_lowercase_text(self, text):
        # Compute lowercase text through CommandLayer without mutating Gtk.TextBuffer.
        result = self.command_layer.dispatch(
            "edit.lowercase",
            CommandContext(source="gui", data={"text": text}),
        )
        if result.success and isinstance(result.value, dict):
            transformed = result.value.get("text", text)
        elif result.success:
            transformed = result.value
        else:
            return text, False
        if not isinstance(transformed, str):
            return text, False
        return transformed, transformed != text

