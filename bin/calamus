def _refresh_line_numbers_after_map(win, _event):
    # The first mapped allocation is the earliest reliable point for applying
    # the viewport-aligned drawing gutter on the real GTK desktop.
    win.update_line_numbers(force=True)
    return False

if __name__ == "__main__":
    win = App()
    win.connect("map-event", _refresh_line_numbers_after_map)
    win.show_all()
    # Keep the synchronous refresh for persisted disabled state; the mapped
    # forced refresh above repairs the first visible allocation when enabled.
    win.update_line_numbers()
    # The canonical right-panel host starts detached.
    Gtk.main()
